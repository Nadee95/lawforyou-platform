# ══════════════════════════════════════════════════════════
#  communication-service — LOCAL SMOKE TEST (MailHog)
#  Uses the MailHog container already in docker-compose.infra.
#  MailHog SMTP listens on port 1025 (no auth needed).
#  View emails at: http://localhost:8025
# ══════════════════════════════════════════════════════════

NODE_ENV=development
PORT=8084

# Kafka — Docker infra
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=communication-service
KAFKA_CLIENT_ID=communication-service

# ── MailHog SMTP (no auth) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@lawforyou.dev

# ── SMS (stub) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Eureka
EUREKA_HOST=localhost
EUREKA_PORT=8761

