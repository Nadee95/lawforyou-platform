# Application
NODE_ENV=development
PORT=8084
# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=communication-service
KAFKA_CLIENT_ID=communication-service
# Email (SMTP) — use Mailhog for local dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@lawforyou.dev
# SMS (Twilio) — leave blank to use stub in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Eureka (Service Discovery)
EUREKA_HOST=localhost
EUREKA_PORT=8761
