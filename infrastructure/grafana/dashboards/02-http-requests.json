{
  "uid": "http-requests",
  "title": "HTTP API Performance",
  "tags": ["http", "api", "lawforyou"],
  "timezone": "browser",
  "refresh": "15s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "api-gateway,user-service,case-service,document-service",
        "current": { "text": "All", "value": "$__all" },
        "options": [
          { "text": "All",            "value": "$__all" },
          { "text": "api-gateway",     "value": "api-gateway" },
          { "text": "user-service",    "value": "user-service" },
          { "text": "case-service",    "value": "case-service" },
          { "text": "document-service","value": "document-service" }
        ],
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total RPS (all services)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[5m]))",
        "legendFormat": "RPS"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[5m]))",
        "legendFormat": "Error Rate"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P99 Latency",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 2 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])))",
        "legendFormat": "P99"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.2 },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])))",
        "legendFormat": "P95"
      }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "P50 Latency",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])))",
        "legendFormat": "P50"
      }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "4xx Errors",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"4..\"}[5m]))",
        "legendFormat": "4xx/s"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Rate per Service",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\"}[5m]))",
        "legendFormat": "{{job}}"
      }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency Percentiles (combined)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "P99"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "P95"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP Status Breakdown",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=~\"$service\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latency per Service (P99)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])))",
        "legendFormat": "{{job}} P99"
      }]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Slowest Endpoints (P99 > 500ms)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "options": { "sortBy": [{ "displayName": "P99", "desc": true }] },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "job" },      "properties": [{ "id": "displayName", "value": "Service" }] },
          { "matcher": { "id": "byName", "options": "uri" },       "properties": [{ "id": "displayName", "value": "Endpoint" }] },
          { "matcher": { "id": "byName", "options": "method" },    "properties": [{ "id": "displayName", "value": "Method" }] },
          { "matcher": { "id": "byName", "options": "Value" },     "properties": [{ "id": "displayName", "value": "P99" }] }
        ]
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.99, sum by (job, uri, method, le) (rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m]))) > 0.5",
        "legendFormat": "{{job}} {{method}} {{uri}}",
        "instant": true,
        "format": "table"
      }]
    }
  ]
}

